        "start": "node dist/src/index.js",
        "migrations:run": "node dist/scripts/migrations/run.js",
        "migrations:run:dev": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/migrations/run.ts",
        "migrations:create": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/migrations/create.ts",
        "docs:generate": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/docs/generate.ts",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "eslint",
        "test:unit": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
