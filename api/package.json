        "pino-pretty": "^13.2.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^4.0.18"
